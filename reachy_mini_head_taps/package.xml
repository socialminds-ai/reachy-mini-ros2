<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachy_mini_head_taps</name>
  <version>1.5.0</version>
  <description>Wake the Reachy Mini up, or put it to sleep, by tapping on its head.</description>
  <maintainer email="severin.lemaignan@iiia.csic.es">Séverin Lemaignan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>audio_common_msgs</depend>
  <depend>motions_skills</depend>
  <depend>std_msgs</depend>
  <depend>std_skills</depend>
  <depend>python3-numpy</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachy_mini</name>
  <version>1.7.0</version>
  <description>Reachy Mini bare-metal ROS 2 support: pulls in the drivers (servos, camera, microphones, speaker), speech recognition and synthesis, and ships the launch file, the parameter files and the systemd unit to run them on the robot.</description>
  <maintainer email="severin.lemaignan@iiia.csic.es">Séverin Lemaignan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>reachy_mini_msgs</exec_depend>
  <!-- Python version of the driver
  <exec_depend>reachy_mini_driver</exec_depend>
  -->
  <exec_depend>reachy_mini_driver_cpp</exec_depend>
  <exec_depend>reachy_mini_description</exec_depend>
  <exec_depend>reachy_mini_expressions_data</exec_depend>
  <exec_depend>reachy_mini_camera_driver</exec_depend>
  <exec_depend>mic_frontend</exec_depend>
  <exec_depend>pw_audio_play</exec_depend>
  <exec_depend>asr_whistle</exec_depend>
  <exec_depend>tts_pockettts</exec_depend>
  <exec_depend>tts_pockettts_model_english_18m_2026_10</exec_depend>
  <exec_depend>tts_pockettts_custom_voices</exec_depend>
  <exec_depend>robot_blackboard</exec_depend>
  <exec_depend>reachy_mini_head_taps</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>

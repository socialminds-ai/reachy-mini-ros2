# Play a recorded move (head pose + antennas + body yaw trajectory) from a
# move library, like the Pollen emotions library.
#
# The move is played by the driver's control loop; the goal can be cancelled at
# any time, the robot then stays where it is.

# Library the move comes from: a HuggingFace dataset name
# (e.g. "pollen-robotics/reachy-mini-emotions-library") or a local directory
# of <name>.json files. Empty = the driver's default library.
string dataset
# Name of the move (file name without .json), e.g. "cheerful1"
string move
# Time (s) to smoothly reach the move's first pose before playing it (0 = jump)
float32 initial_goto_duration 0.5
---
bool completed        # true if played to the end, false if cancelled or failed
string message
---
float32 progress      # 0.0 .. 1.0
float32 elapsed       # seconds since the move started

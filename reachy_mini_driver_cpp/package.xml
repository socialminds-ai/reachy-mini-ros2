<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachy_mini_driver_cpp</name>
  <version>1.6.0</version>
  <description>Bare-metal hardware driver for the Reachy Mini (C++): owns the servo bus through reachy_mini_c, runs the 50 Hz control loop, publishes joint states and TF, and implements the ROS4HRI skills replay_motion, list_motions, execute_cartesian_trajectory, execute_joint_trajectory and look_at. Replaces the Pollen daemon.</description>
  <maintainer email="severin.lemaignan@iiia.csic.es">Séverin Lemaignan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>reachy_mini_c</depend>
  <depend>reachy_mini_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>motions_skills</depend>
  <depend version_gte="1.9.1">interaction_skills</depend>
  <depend>std_skills</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>eigen</depend>
  <depend>nlohmann-json-dev</depend>
  <exec_depend>reachy_mini_expressions_data</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachy_mini_driver</name>
  <version>1.2.2</version>
  <description>Bare-metal hardware driver for the Reachy Mini (Python): owns the servo bus, runs the 50 Hz control loop, publishes joint states and TF, and implements the ROS4HRI replay_motion and list_motions skills. Reference implementation; the C++ driver has the full skill set.</description>
  <maintainer email="severin.lemaignan@iiia.csic.es">Séverin Lemaignan</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>rclpy</depend>
  <depend>reachy_mini_msgs</depend>
  <depend>motions_skills</depend>
  <depend>std_skills</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros_py</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <!-- reachy_mini (pip): motor controller, kinematics and move loader. Not a rosdep key;
       see REFERENCE.md (The Python driver). -->
  <exec_depend>reachy_mini_expressions_data</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reachy_mini_camera_driver</name>
  <version>0.6.0</version>
  <description>Camera driver for the Reachy Mini: captures the IMX708 CSI camera through libcamera, encodes H.264 on the Raspberry Pi hardware encoder, and publishes the packets for ffmpeg_image_transport (and Foxglove), plus raw frames on demand. Resolution, frame rate and bitrate are dynamic parameters.</description>
  <maintainer email="severin.lemaignan@iiia.csic.es">Séverin Lemaignan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>camera_info_manager</depend>
  <depend>ffmpeg_image_transport_msgs</depend>
  <depend>foxglove_msgs</depend>
  <depend>libgstreamer1.0-dev</depend>
  <depend>libgstreamer-plugins-base1.0-dev</depend>

  <!-- v4l2h264enc (plugins-good), h264parse (plugins-bad). libcamerasrc comes
       from gstreamer1.0-libcamera and libcamera-ipa, which have no rosdep key:
       the robot image (docker/Dockerfile) installs them. -->
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>
  <exec_depend>ffmpeg_image_transport</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
